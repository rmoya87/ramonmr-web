      "layout": {
        "cardRadius": "10px"
      },
      "type": {
        "heroLine": "90px",
        "headingLine": "65px",
        "bodyLine": "1.6"
      }
    }
  },
  "styles": {
    "color": {
      "text": "var:preset|color|ink",
      "background": "var:preset|color|white"
    },
    "typography": {
      "fontFamily": "var:preset|font-family|sans",
      "fontSize": "var:preset|font-size|body",
      "lineHeight": "1.6"
    },
    "spacing": {
      "blockGap": "0px"
    },
    "elements": {
      "link": {
        "color": {
          "text": "inherit"
        },
        "typography": {
          "textDecoration": "none"
        }
      },
      "heading": {
        "typography": {
          "fontFamily": "inherit",
          "fontWeight": "400"
        }
      }
    },
    "blocks": {
      "core/button": {
        "border": {
          "radius": "100px"
        },
        "color": {
          "background": "var:preset|color|blue",
          "text": "var:preset|color|white"
        },
        "typography": {
          "fontSize": "var:preset|font-size|small"
        },
        "variations": {
          "outline": {
            "color": {
              "text": "var:preset|color|blue",
              "background": "transparent"
            },
            "border": {
              "color": "var:preset|color|blue",
              "width": "1px"
            },
            "spacing": {
              "padding": {
                "top": "8px",
                "bottom": "8px",
                "left": "16px",
                "right": "16px"
              }
            }
          }
        }
      },
      "core/heading": {
        "typography": {
          "fontFamily": "inherit"
        }
      }
    }
  },
  "customTemplates": [
    {
      "name": "cv",
      "title": "Curriculum Ramón",
      "postTypes": [
        "page"
      ]
    },
    {
      "name": "landing",
      "title": "Página de secciones",
      "postTypes": [
        "page"
      ]
    }
  ],
  "templateParts": [
    {
      "name": "header",
      "title": "Cabecera",
      "area": "header"
    },
    {
      "name": "footer",
      "title": "Pie",
      "area": "footer"
    }
  ]
